{
  "name": "techsched",
  "productName": "TechSched",
  "version": "1.1.3",
  "description": "Monthly schedule generator for Excel, PDF and image output",
  "author": "marchugue",
  "license": "MIT",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/marchugue/techsched.git"
  },
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "call-bind-apply-helpers": "^1.0.2",
    "dunder-proto": "^1.0.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.techsched.app",
    "productName": "TechSched",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "marchugue",
      "repo": "techsched",
      "releaseType": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json",
      "node_modules/call-bind-apply-helpers/**/*",
      "node_modules/dunder-proto/**/*",
      "node_modules/gopd/**/*",
      "node_modules/call-bound/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TechSched",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
